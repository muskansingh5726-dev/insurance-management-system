generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  customer Customer?
}

model Customer {
  id      Int      @id @default(autoincrement())
  phone   String
  address String
  dob     DateTime

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  policies Policy[]

  documents Document[]
}

model Policy {
  id Int @id @default(autoincrement())

  policyNumber String @unique

  policyType String

  premium Float

  startDate DateTime

  endDate DateTime

  status PolicyStatus

  customerId Int

  customer Customer @relation(fields: [customerId], references: [id])

  claims Claim[]

  payments PremiumPayment[]
}

model Claim {
  id Int @id @default(autoincrement())

  claimAmount Float

  reason String

  status ClaimStatus

  submittedAt DateTime @default(now())

  policyId Int

  policy Policy @relation(fields: [policyId], references: [id])
}

model PremiumPayment {
  id Int @id @default(autoincrement())

  amount Float

  paymentDate DateTime

  status PaymentStatus

  policyId Int

  policy Policy @relation(fields: [policyId], references: [id])
}

model Document {
  id Int @id @default(autoincrement())

  fileName String

  filePath String

  uploadedAt DateTime @default(now())

  customerId Int

  customer Customer @relation(fields: [customerId], references: [id])
}
